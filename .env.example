# Copy to apps/web/.env.local for local development. Never commit real values.
# Variables are validated with zod in apps/web/src/env/.
# Vercel: set per environment (Production -> Supabase prod, Preview -> Supabase staging).

# --- Supabase (M0) -----------------------------------------------------------
# Local values are printed by `pnpm db:start`.
# Hosted values: Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key only (sb_publishable_...). Browser-safe; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server (M0) -------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Algeria market kill switch. Exactly "true" or "false". Open by the owner's decision (D-068);
# "false" stops new Algerian signups.
MARKET_DZ_ENABLED=true
# Search indexing (D-054). Exactly "true" or "false". Only takes effect on the production deployment;
# keep false until public launch.
SITE_INDEXABLE=false
# Before public launch, lets only the AI crawlers named in src/seo/robots.ts read the public pages
# (D-303). Exactly "true" or "false". Production only; ignored once SITE_INDEXABLE is true.
AI_CRAWLERS_ALLOWED=false
# "Continue with Google" (D-065). Exactly "true" or "false". Set true only after Google is enabled
# in this environment's Supabase project (docs/runbooks/auth-setup.md).
AUTH_GOOGLE_ENABLED=false
# The button also needs Google enabled in that Supabase project, which the app checks at runtime
# (D-089). Tests only: AUTH_GOOGLE_VERIFY_PROVIDER=false skips that check. `pnpm test:e2e:auth`
# sets both itself, as the e2e-auth CI job does.

# --- AI (M3c, server only) ---------------------------------------------------
# anthropic | fake | off. "fake" is a deterministic stand-in: no key, no network call, no cost
# (D-123). Keep it locally. On Vercel leave AI_PROVIDER unset, which means anthropic.
AI_PROVIDER=fake
# Only with AI_PROVIDER=anthropic. In Vercel, a Sensitive variable for Production and Preview;
# never commit it. Without it the diagnostic runs its fixed checks only.
# ANTHROPIC_API_KEY=

# --- Full report preview (M5, server only, temporary) ------------------------
# Comma-separated email addresses that see the full report before paid plans exist (D-232, D-245).
# Empty means nobody. The owner sets it on Vercel; it is removed with M7.
FULL_REPORT_PREVIEW_EMAILS=
# "true" opens the full report to every signed-in account while paid plans do not exist (early
# access, D-290). Anything else, or empty, is off. The owner sets it on Vercel; removed with M7.
EARLY_ACCESS_FULL_REPORT=

# --- Payments (M7, server only) ---------------------------------------------
# Paddle as merchant of record (D-309). Without both values the webhook answers 503 and the rest of
# the site works. In Vercel, Sensitive variables; sandbox values for Preview, live for Production.
# Paddle dashboard -> Developer tools -> Notifications -> the destination's secret key.
# PADDLE_WEBHOOK_SECRET=
# Supabase dashboard -> Project Settings -> API Keys -> a secret key (sb_secret_...). Bypasses row
# level security: used only by the payment webhook (D-310). Never NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# --- Not needed by the app ---------------------------------------------------
# Sign-in email goes through Supabase Auth (custom SMTP set in the Supabase dashboard, D-061), and
# account deletion runs inside the database; the only Supabase secret key is the payment
# webhook's (D-077, D-310).
# Google's client ID and secret live in the Supabase dashboard, never in the app.

# --- Later milestones (not validated yet) ------------------------------------
# First scheduled job: bearer token Vercel Cron sends to cron routes.
# CRON_SECRET=
