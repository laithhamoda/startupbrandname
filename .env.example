# Copy to apps/web/.env.local for local development. Never commit real values.
# Variables are validated with zod in apps/web/src/env/.
# Vercel: set per environment (Production -> Supabase prod, Preview -> Supabase staging).

# --- Supabase (M0) -----------------------------------------------------------
# Local values are printed by `pnpm db:start`.
# Hosted values: Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key only (sb_publishable_...). Browser-safe; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server (M0) -------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Algeria market. Exactly "true" or "false". Keep false until legal review (CLAUDE.md §3).
MARKET_DZ_ENABLED=false
# Search indexing (D-054). Exactly "true" or "false". Only takes effect on the production deployment;
# keep false until public launch.
SITE_INDEXABLE=false

# --- Later milestones (not validated yet) ------------------------------------
# M2: server-only secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
# M2: public origin used in auth redirect links.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# M2: transactional email provider, not chosen yet (docs/OPEN-QUESTIONS.md #32).
# EMAIL_API_KEY=
# M3: Anthropic API key, server-only.
# ANTHROPIC_API_KEY=
# M7: PayPal (sandbox | live).
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# First scheduled job: bearer token Vercel Cron sends to cron routes.
# CRON_SECRET=
