# Copy to apps/web/.env.local for local development. Never commit real values.
# Variables are validated with zod in apps/web/src/env/.
# Vercel: set per environment (Production -> Supabase prod, Preview -> Supabase staging).

# --- Supabase (M0) -----------------------------------------------------------
# Local values are printed by `pnpm db:start`.
# Hosted values: Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key only (sb_publishable_...). Browser-safe; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server (M0) -------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Algeria market kill switch. Exactly "true" or "false". Open by the owner's decision (D-068);
# "false" stops new Algerian signups.
MARKET_DZ_ENABLED=true
# Search indexing (D-054). Exactly "true" or "false". Only takes effect on the production deployment;
# keep false until public launch.
SITE_INDEXABLE=false
# "Continue with Google" (D-065). Exactly "true" or "false". Set true only after Google is enabled
# in this environment's Supabase project (docs/runbooks/auth-setup.md).
AUTH_GOOGLE_ENABLED=false
# The button also needs Google enabled in that Supabase project, which the app checks at runtime
# (D-089). Tests only: AUTH_GOOGLE_VERIFY_PROVIDER=false skips that check.

# --- Not needed by the app ---------------------------------------------------
# Sign-in email goes through Supabase Auth (custom SMTP set in the Supabase dashboard, D-061), and
# account deletion runs inside the database, so the app needs no secret key in M2.
# Google's client ID and secret live in the Supabase dashboard, never in the app.

# --- Later milestones (not validated yet) ------------------------------------
# M7: PayPal (sandbox | live).
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# First scheduled job: bearer token Vercel Cron sends to cron routes.
# CRON_SECRET=

# AI features (M3c, server only). Set the key as a Sensitive variable in Vercel; never commit it.
# Without it the diagnostic runs its fixed checks only. AI_PROVIDER=fake is for tests (D-123).
# ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
