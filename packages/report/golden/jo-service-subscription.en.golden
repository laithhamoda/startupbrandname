    {
      "id": "validation_plan",
      "title": "Validation plan",
      "locked": false,
      "blocks": [
        {
          "type": "paragraph",
          "text": [
            "A test plan of ",
            {
              "n": "30"
            },
            " days: test the most important assumptions before you spend on them, ranked by how much each moves your profit and how confident you are in it."
          ]
        },
        {
          "type": "callout",
          "tone": "worry",
          "text": [
            "“هل سيقبل العملاء دفع اشتراك شهري بهذا السعر؟”"
          ]
        },
        {
          "type": "definitionList",
          "title": [
            "Your own worry"
          ],
          "items": [
            {
              "term": [
                "The test"
              ],
              "definition": {
                "text": [
                  "The smallest test that answers your worry alone: show your idea to prospective customers and ask for a decision, not an opinion."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "Success line"
              ],
              "definition": {
                "text": [
                  "The worry is yours, so the line you accept is your choice. This is the protocol’s default description; you set the number you will accept before you start."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "If it fails"
              ],
              "definition": {
                "text": [
                  "Ask an expert in your field before you go on."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "Cost"
              ],
              "definition": {
                "text": [
                  "Your time"
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            }
          ]
        },
        {
          "type": "definitionList",
          "title": [
            "Test ",
            {
              "n": "2"
            }
          ],
          "items": [
            {
              "term": [
                "Why"
              ],
              "definition": {
                "text": [
                  "Your price is ",
                  {
                    "n": "30.000"
                  },
                  " ",
                  {
                    "l": "JOD"
                  },
                  ". Changing it by ",
                  {
                    "n": "20%"
                  },
                  " moves year-one profit by ",
                  {
                    "n": "21,600.000"
                  },
                  " ",
                  {
                    "l": "JOD"
                  },
                  ". Your confidence in it is High."
                ],
                "provenance": {
                  "source": "user",
                  "confidence": "high",
                  "validated": true
                },
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "The test"
              ],
              "definition": {
                "text": [
                  "Offer the product or service at this price to prospective customers and record who actually agrees to pay."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "Success line"
              ],
              "definition": {
                "text": [
                  "The share of those you ask who actually agree to pay, not those who merely like the offer. This is the protocol’s default description; you set the number you will accept before you start."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "If it fails"
              ],
              "definition": {
                "text": [
                  "Try a second price on a new group."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
