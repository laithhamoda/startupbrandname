    {
      "id": "validation_plan",
      "title": "خطة التحقق",
      "locked": false,
      "blocks": [
        {
          "type": "paragraph",
          "text": [
            "خطة اختبار مدتها ",
            {
              "n": "30"
            },
            " يومًا: اختبر الافتراضات الأهم قبل أن تنفق عليها، مرتبةً بحسب أثر كل افتراض في ربحك ومدى ثقتك به."
          ]
        },
        {
          "type": "callout",
          "tone": "worry",
          "text": [
            "«هل سيقبل العملاء دفع اشتراك شهري بهذا السعر؟»"
          ]
        },
        {
          "type": "definitionList",
          "title": [
            "قلقك أنت"
          ],
          "items": [
            {
              "term": [
                "الاختبار"
              ],
              "definition": {
                "text": [
                  "أصغر اختبار يجيب عن قلقك وحده: اعرض فكرتك على عملاء محتملين واطلب منهم قرارًا لا رأيًا."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "حدّ النجاح"
              ],
              "definition": {
                "text": [
                  "القلق قلقك، فالحدّ الذي ترضى به من اختيارك. هذا وصف افتراضي من بروتوكول الاختبار، وتضع أنت الرقم الذي تقبله قبل أن تبدأ."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "إن لم ينجح"
              ],
              "definition": {
                "text": [
                  "اسأل خبيرًا في مجالك قبل أن تتابع."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "التكلفة"
              ],
              "definition": {
                "text": [
                  "وقتك"
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            }
          ]
        },
        {
          "type": "definitionList",
          "title": [
            "الاختبار ",
            {
              "n": "2"
            }
          ],
          "items": [
            {
              "term": [
                "لماذا"
              ],
              "definition": {
                "text": [
                  "سعرك ",
                  {
                    "n": "30.000"
                  },
                  " د.أ. تغييره بنسبة ",
                  {
                    "n": "20%"
                  },
                  " يحرّك ربح السنة الأولى بمقدار ",
                  {
                    "n": "21,600.000"
                  },
                  " د.أ. ثقتك فيه مرتفعة."
                ],
                "provenance": {
                  "source": "user",
                  "confidence": "high",
                  "validated": true
                },
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "الاختبار"
              ],
              "definition": {
                "text": [
                  "اعرض المنتج أو الخدمة بهذا السعر على عملاء محتملين وسجّل من يقبل أن يدفع فعلًا."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "حدّ النجاح"
              ],
              "definition": {
                "text": [
                  "نسبة من تعرض عليهم ويقبلون الدفع فعلًا، لا من يعجبهم العرض فقط. هذا وصف افتراضي من بروتوكول الاختبار، وتضع أنت الرقم الذي تقبله قبل أن تبدأ."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "إن لم ينجح"
              ],
              "definition": {
                "text": [
                  "جرّب سعرًا ثانيًا على مجموعة جديدة."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
