    {
      "id": "top_risks",
      "title": "أهم ثلاث مخاطر",
      "locked": false,
      "blocks": [
        {
          "type": "list",
          "title": null,
          "ordered": false,
          "items": [
            [
              "السعر (",
              {
                "n": "30.000"
              },
              " د.أ) أقل من أدنى سعر يغطي تكاليفك (",
              {
                "n": "30.833"
              },
              " د.أ)."
            ],
            [
              "التعادل (",
              {
                "n": "6"
              },
              " أشهر) بعد المدة التي تتحمّلها بلا دخل (",
              {
                "n": "3"
              },
              " أشهر)."
            ],
            [
              "تكاليف التأسيس (",
              {
                "n": "12,000.000"
              },
              " د.أ) فوق أدنى رأس مال متاح (",
              {
                "n": "8,000.000"
              },
              " د.أ) وتحت أقصاه (",
              {
                "n": "15,000.000"
              },
              " د.أ)."
            ]
          ]
        }
      ]
    },
    {
      "id": "break_even",
      "title": "تقدير التعادل",
      "locked": false,
      "blocks": [
        {
          "type": "paragraph",
          "text": [
            "يبلغ مشروعك نقطة التعادل (",
            {
              "l": "Break-even"
            },
            ") في الشهر ",
            {
              "n": "6"
            },
            " وفق تقديرنا، عند ",
            {
              "n": "171"
            },
            " وحدة شهريًا وإيراد شهري قدره ",
            {
              "n": "5,125.000"
            },
            " د.أ."
          ]
        },
        {
          "type": "note",
          "text": [
            "تقدير من أرقامك وافتراضات المحرك، وليس وعدًا بنتيجة."
          ]
        }
      ]
