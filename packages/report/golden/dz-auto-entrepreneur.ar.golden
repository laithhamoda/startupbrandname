        },
        {
          "type": "list",
          "title": [
            "أهم المخاطر"
          ],
          "ordered": false,
          "items": [
            [
              "إيراداتك في السنة ",
              {
                "n": "3"
              },
              " (",
              {
                "n": "7,126,000.00"
              },
              " د.ج) تتجاوز سقف النظام الضريبي ",
              {
                "l": "fixture_auto_entrepreneur"
              },
              " (",
              {
                "n": "5,000,000.00"
              },
              " د.ج)."
            ],
            [
              "تكاليف التأسيس (",
              {
                "n": "300,000.00"
              },
              " د.ج) فوق أدنى رأس مال متاح (",
              {
                "n": "200,000.00"
              },
              " د.ج) وتحت أقصاه (",
              {
                "n": "400,000.00"
              },
              " د.ج)."
            ],
            [
              "قلقك أنت: «هل يستمر الطلب على الأكل المنزلي خارج المناسبات؟»."
            ]
