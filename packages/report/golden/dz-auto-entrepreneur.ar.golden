    {
      "id": "executive_summary",
      "title": "الملخص التنفيذي",
      "locked": false,
      "blocks": [
        {
          "type": "paragraph",
          "text": [
            "هذا التقرير موجّه إلى جهة مانحة، فيبدأ بموعد التعادل، ثم احتياج التمويل، ثم ربح السنة الأولى."
          ]
        },
        {
          "type": "verdict",
          "code": "go",
          "word": "امضِ",
          "reason": [
            "يتحقق ",
            {
              "n": "8"
            },
            " من ",
            {
              "n": "9"
            },
            " من معايير الجدوى (",
            {
              "n": "88.89%"
            },
            ")، وهذا يبلغ خط «امضِ» (",
            {
              "n": "75%"
            },
            ") أو يتجاوزه، ولا يوجد معيار حاجب، وثقتك في الأرقام المحورية كافية. الدرجة ليست احتمال نجاح، بل نسبة المعايير التي تحققت."
          ],
          "stopSentence": null,
          "meter": {
            "passed": 8,
            "evaluated": 9,
            "linePercent": 75,
            "caption": [
              "معايير الجدوى المتحققة: ",
              {
                "n": "8"
              },
              " من ",
              {
                "n": "9"
              },
              ". حدّ «امضِ» عند ",
              {
                "n": "75%"
              },
              "."
            ]
          }
        },
