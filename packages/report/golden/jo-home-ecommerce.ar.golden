    {
      "id": "validation_plan",
      "title": "خطة التحقق",
      "locked": false,
      "blocks": [
        {
          "type": "paragraph",
          "text": [
            "خطة اختبار مدتها ",
            {
              "n": "30"
            },
            " يومًا: اختبر الافتراضات الأهم قبل أن تنفق عليها، مرتبةً بحسب أثر كل افتراض في ربحك ومدى ثقتك به."
          ]
        },
        {
          "type": "definitionList",
          "title": [
            "الاختبار ",
            {
              "n": "1"
            }
          ],
          "items": [
            {
              "term": [
                "لماذا"
              ],
              "definition": {
                "text": [
                  "سعرك ",
                  {
                    "n": "40.000"
                  },
                  " د.أ. تغييره بنسبة ",
                  {
                    "n": "20%"
                  },
                  " يحرّك ربح السنة الأولى بمقدار ",
                  {
                    "n": "19,200.000"
                  },
                  " د.أ. ثقتك فيه مرتفعة."
                ],
                "provenance": {
                  "source": "user",
                  "confidence": "high",
                  "validated": true
                },
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "الاختبار"
              ],
              "definition": {
                "text": [
                  "اعرض المنتج أو الخدمة بهذا السعر على عملاء محتملين وسجّل من يقبل أن يدفع فعلًا."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "حدّ النجاح"
              ],
              "definition": {
                "text": [
                  "نسبة من تعرض عليهم ويقبلون الدفع فعلًا، لا من يعجبهم العرض فقط. هذا وصف افتراضي من بروتوكول الاختبار، وتضع أنت الرقم الذي تقبله قبل أن تبدأ."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "إن لم ينجح"
              ],
              "definition": {
                "text": [
                  "جرّب سعرًا ثانيًا على مجموعة جديدة."
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            },
            {
              "term": [
                "التكلفة"
              ],
              "definition": {
                "text": [
                  "وقتك"
                ],
                "provenance": null,
                "lowConfidence": false,
                "mark": null
              },
              "tag": null,
              "label": null,
              "url": null
            }
          ]
        },
